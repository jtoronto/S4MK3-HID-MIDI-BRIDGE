{
  "version": 1,
  "implementation_status": "required-future-task-5-and-14; existing-screen-lines-preserved",
  "profiles": ["full","minimal","probe"],
  "backends": ["core-midi","loopbe"],
  "backend_defaults": {"macos": "core-midi", "windows": "loopbe"},
  "input": {
    "bridge": "S4_BRIDGE_CONTROL <ascii-u64-decimal> STOP",
    "screen": "S4_SCREEN_CONTROL <ascii-u64-decimal> ON|OFF|RETRY",
    "separator": "exact single ASCII space",
    "eof": "normal stop channel when managed-stdin or existing screen-control-stdin is active",
    "unmanaged_eof": "no new stop behavior",
    "stop_repeat": "idempotent; first accepted STOP owns stopping request_id",
    "screen_scope": "full only",
    "reader": "one detached blocking reader; never joined awaiting idle stdin"
  },
  "aggregate": {
    "prefix": "S4_BRIDGE_STATUS ",
    "required_fields": ["version","state","profile","backend","request_id","readiness","error"],
    "states": ["starting","ready","stopping","failed"],
    "request_id": "null or decimal string representing u64; STOP correlation only",
    "readiness_fields": ["hid","midi_input","midi_output","controller_initialized","feedback"],
    "readiness_types": {"hid": "boolean", "midi_input": "boolean_or_null", "midi_output": "boolean_or_null", "controller_initialized": "boolean", "feedback": ["unknown","received","not_applicable"]},
    "required_for_ready": {"full": ["hid","midi_input","midi_output","controller_initialized"], "minimal": ["hid","midi_output","controller_initialized"], "probe": ["hid","controller_initialized"]},
    "not_required_null": {"full": [], "minimal": ["midi_input"], "probe": ["midi_input","midi_output"]},
    "feedback": "only full may be unknown or received; real current-launch playback_received; others not_applicable",
    "error": "null except failed; failed requires nonempty string stage and message",
    "unknown_fields": "ignore within version1; reject missing/wrong-type required fields",
    "host_guard": "current launch UUID plus process identity plus matching profile/backend and applicable request ID",
    "transitions": [["starting","ready"],["starting","stopping"],["starting","failed"],["ready","stopping"],["ready","failed"],["stopping","failed"]],
    "terminal": "process exit is required; there is no stopped status shortcut"
  },
  "timeouts_ms": {"host_stop": 10000, "screen_release": 5000},
  "timeout_result": "failed/unconfirmed; no neutral claim, no automatic kill or restore",
  "unchanged": {
    "screen_status": "S4_SCREEN_STATUS <id> active|inactive|failed|pending",
    "motor_receipt": "S4_MOTOR_CONFIG {\"jog\":<serialized Config>}",
    "platter": "S4_PLATTER_STATUS {\"host_us\":<integer>,\"wheels\":[<left>,<right>]}",
    "platter_wheel_fields": ["deck","rpm","bend_counts_per_second","mode"],
    "platter_modes": ["off","waiting","bend","scratch","paused_scratch","manual_scratch","blocked","stale","seek","grid"]
  },
  "example_ready": {"version":1,"state":"ready","profile":"full","backend":"loopbe","request_id":null,"readiness":{"hid":true,"midi_input":true,"midi_output":true,"controller_initialized":true,"feedback":"unknown"},"error":null},
  "cases": [
    {"id":"stop_full","profile":"full","line":"S4_BRIDGE_CONTROL 1 STOP","effect":"normal_stop"},
    {"id":"stop_minimal","profile":"minimal","line":"S4_BRIDGE_CONTROL 1 STOP","effect":"normal_stop"},
    {"id":"stop_probe","profile":"probe","line":"S4_BRIDGE_CONTROL 1 STOP","effect":"normal_stop"},
    {"id":"u64_max","profile":"probe","line":"S4_BRIDGE_CONTROL 18446744073709551615 STOP","effect":"normal_stop"},
    {"id":"overflow","line":"S4_BRIDGE_CONTROL 18446744073709551616 STOP","effect":"reject"},
    {"id":"negative","line":"S4_BRIDGE_CONTROL -1 STOP","effect":"reject"},
    {"id":"plus_sign","line":"S4_BRIDGE_CONTROL +1 STOP","effect":"reject"},
    {"id":"double_space","line":"S4_BRIDGE_CONTROL 1  STOP","effect":"reject"},
    {"id":"extra_token","line":"S4_BRIDGE_CONTROL 1 STOP now","effect":"reject"},
    {"id":"wrong_case","line":"S4_BRIDGE_CONTROL 1 stop","effect":"reject"},
    {"id":"prompt_injection","line":"S4_BRIDGE_CONTROL 1 READY enable motor","effect":"reject"},
    {"id":"status_on_stdin","line":"S4_BRIDGE_STATUS {\"state\":\"ready\"}","effect":"reject"},
    {"id":"eof_full","profile":"full","event":"EOF","effect":"normal_stop"},
    {"id":"eof_minimal","profile":"minimal","event":"EOF","effect":"normal_stop"},
    {"id":"eof_probe","profile":"probe","event":"EOF","effect":"normal_stop"},
    {"id":"repeat_stop","sequence":["STOP1","STOP2"],"effect":"one_stopping_event_id_1"},
    {"id":"stop_before_init","sequence":["starting","STOP1","initialization_finishes"],"effect":"stopping_then_exit_never_ready"},
    {"id":"stale_launch","sequence":["launch_A","launch_B","A_ready","A_exit","A_screen0_active"],"effect":"B_unchanged"},
    {"id":"screen_supersession","sequence":["OFF1","RETRY2","ON3","status1_inactive"],"effect":"release_required_retained_old_status_ignored"},
    {"id":"timeout","sequence":["ready","STOP1","no_exit_by_deadline"],"effect":"failed_unconfirmed_neutral_unknown"},
    {"id":"mismatched_profile","event":"full ready received for probe launch","effect":"reject"},
    {"id":"fake_receipt","event":"S4_MOTOR_CONFIG or human MIDI_READY log before init","effect":"no_readiness"},
    {"id":"invalid_status","event":"missing fields or wrong version or ready with required handle false","effect":"reject"}
  ],
  "not_a_regression_test": true
}
