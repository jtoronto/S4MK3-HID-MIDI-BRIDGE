<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <WindowsSDKPackageVersion>10.0.26100.57</WindowsSDKPackageVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <CSWinRTInputs>Windows.Devices.Midi2</CSWinRTInputs>
    <CsWinRTIncludes>Windows.Devices.Midi2</CsWinRTIncludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" GeneratePathProperty="true" />
    <PackageReference Include="Windows.Devices.Midi2" Version="0.99.92-preview.11" GeneratePathProperty="true" />
    <Compile Include="../bridge-app/Core/BloopEndpoint.cs" Link="Core/BloopEndpoint.cs" />
    <Compile Include="../bridge-app/Core/PreferenceStore.cs" Link="Core/PreferenceStore.cs" />
    <Compile Include="../bridge-app/Models/*.cs" Exclude="../bridge-app/Models/WindowPlacement.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../bridge-app/Platform/BloopEndpointOwner.cs" Link="Platform/BloopEndpointOwner.cs" />
    <Compile Include="../loopbe-probe/NativePort.cs" Link="NativePort.cs" />
    <Compile Include="../loopbe-probe/Exchange.cs" Link="Exchange.cs" />
    <None Include="$(PkgWindows_Devices_Midi2)/ref/net10.0/Windows.Devices.Midi2.winmd" Link="Windows.Devices.Midi2.winmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../licenses/Microsoft-MIDI-LICENSE.txt" Link="Microsoft-MIDI-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(PkgMicrosoft_Windows_CsWinRT)/LICENSE" Link="CsWinRT-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(PkgMicrosoft_Windows_CsWinRT)/NOTICE.txt" Link="CsWinRT-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ConfigureMacGuidOptimizer" BeforeTargets="CsWinRTInvokeGuidPatcher"
          DependsOnTargets="CsWinRTGenerateIIDOptimizerResponseFile" Condition="'$(S4ProbeDotnet)' != ''">
    <PropertyGroup>
      <CsWinRTIIDOptimizerCommand>"$(S4ProbeDotnet)" --roll-forward Major "$(CsWinRTPath)build/tools/IIDOptimizer/IIDOptimizer.dll" @"$(CsWinRTIIDOptimizerResponseFile)"</CsWinRTIIDOptimizerCommand>
    </PropertyGroup>
  </Target>
</Project>
