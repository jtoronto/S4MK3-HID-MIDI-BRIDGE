<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;osx-arm64</RuntimeIdentifiers>
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.8" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.8" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.8" />
    <Compile Include="../bridge-app/Views/**/*.cs" Link="Views/%(Filename)%(Extension)" />
    <Compile Include="../bridge-app/Models/**/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../bridge-app/Core/**/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../bridge-app/Diagnostics/**/*.cs" Link="Diagnostics/%(Filename)%(Extension)" />
    <Compile Include="../bridge-app/Platform/NIServiceControl.cs" Link="Platform/NIServiceControl.cs" />
    <Compile Include="../bridge-app/Packaging/PackageValidation.cs" Link="Packaging/PackageValidation.cs" />
    <Content Include="../../examples/*-config.json" Link="Resources/default-%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
