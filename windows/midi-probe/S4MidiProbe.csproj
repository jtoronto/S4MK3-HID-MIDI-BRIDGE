<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <WindowsSDKPackageVersion>10.0.26100.57</WindowsSDKPackageVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <CSWinRTInputs>Windows.Devices.Midi2</CSWinRTInputs>
    <CsWinRTIncludes>Windows.Devices.Midi2</CsWinRTIncludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <PackageReference Include="Windows.Devices.Midi2" Version="0.99.92-preview.11"
                      GeneratePathProperty="true" />
    <None Include="$(PkgWindows_Devices_Midi2)/ref/net10.0/Windows.Devices.Midi2.winmd"
          Link="Windows.Devices.Midi2.winmd"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ConfigureMacGuidOptimizer"
          BeforeTargets="CsWinRTInvokeGuidPatcher"
          DependsOnTargets="CsWinRTGenerateIIDOptimizerResponseFile"
          Condition="'$(S4ProbeDotnet)' != ''">
    <PropertyGroup>
      <CsWinRTIIDOptimizerCommand>"$(S4ProbeDotnet)" --roll-forward Major "$(CsWinRTPath)build/tools/IIDOptimizer/IIDOptimizer.dll" @"$(CsWinRTIIDOptimizerResponseFile)"</CsWinRTIIDOptimizerCommand>
    </PropertyGroup>
  </Target>
</Project>
